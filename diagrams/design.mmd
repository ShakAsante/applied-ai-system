flowchart TD
    Input["User input\n(profile or query)"]
    Catalog[("Song catalog\ndata/*.csv")]

    subgraph Heuristic["Heuristic recommender"]
        ScorerH["score_song\nrule-based ranking"]
    end

    subgraph Agentic["Agentic recommender (RAG)"]
        Retriever["RETRIEVER\nSongEmbeddingIndex\n(sentence-transformers)"]
        Agent["AGENT\nClaude (generation.py)\nrank + explain"]
        Retriever --> Agent
    end

    Output["Recommendations\n+ explanation"]

    subgraph Evaluator["Evaluator"]
        Eval["evaluation.py / evaluate.py\naccuracy + bias metrics"]
    end

    subgraph Tester["Tester"]
        Tests["tests/\npytest"]
    end

    Input --> Catalog
    Catalog --> ScorerH --> Output
    Catalog --> Retriever
    Agent --> Output

    Output --> Eval
    Catalog --> Eval

    ScorerH -. verified by .-> Tests
    Eval -. verified by .-> Tests
